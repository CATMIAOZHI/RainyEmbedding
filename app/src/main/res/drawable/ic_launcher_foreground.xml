<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 通过一个完美的内部缩放，使得图案悬浮于粉色渐变背景之上 -->
    <group android:pivotX="54" android:pivotY="54" android:scaleX="0.80" android:scaleY="0.80">

        <!-- 极细的外部空间包围辅助线 (悬浮流形感，纯白 30% 透明) -->
        <path
            android:strokeColor="#66FFFFFF"
            android:strokeWidth="1.5"
            android:pathData="M 54,20 C 72.78,20 88,35.22 88,54 C 88,72.78 72.78,88 54,88 C 35.22,88 20,72.78 20,54 C 20,35.22 35.22,20 54,20 Z" />

        <!-- 细微透出的正二十面体/六边形暗纹（增加高维科技感），使用纯白微明线条 -->
        <path
            android:strokeColor="#99FFFFFF"
            android:strokeWidth="1.5"
            android:strokeLineJoin="round"
            android:pathData="M 54,30 L 74,42 L 74,66 L 54,78 L 34,66 L 34,42 Z" />

        <!-- 核心节点：源张量数据原点 (使用纯白加强高光) -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M 54,48.5 A 5.5,5.5 0 1 1 53.9,48.5 Z" />

        <!-- 向外发射的四象限高维向量箭头（纤细优雅版） -->
        <!-- 线条变细：从原本厚重的6减细到极具美感的 3.5 -->
        <group>
            <!-- ============ 第一象限 (右上角) ============ -->
            <!-- 主维通道 -->
            <path
                android:strokeColor="#FF6B8E"
                android:strokeWidth="3.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M 58,50 L 78,30" />
            <path
                android:strokeColor="#FF6B8E"
                android:strokeWidth="3.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M 78,38 L 78,30 L 70,30" />

            <!-- ============ 第二象限 (左上角) ============ -->
            <path
                android:strokeColor="#FF6B8E"
                android:strokeWidth="3.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M 50,50 L 30,30" />
            <path
                android:strokeColor="#FF6B8E"
                android:strokeWidth="3.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M 30,38 L 30,30 L 38,30" />

            <!-- ============ 第三象限 (左下角) ============ -->
            <path
                android:strokeColor="#FF6B8E"
                android:strokeWidth="3.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M 50,58 L 30,78" />
            <path
                android:strokeColor="#FF6B8E"
                android:strokeWidth="3.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M 30,70 L 30,78 L 38,78" />

            <!-- ============ 第四象限 (右下角) ============ -->
            <path
                android:strokeColor="#FF6B8E"
                android:strokeWidth="3.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M 58,58 L 78,78" />
            <path
                android:strokeColor="#FF6B8E"
                android:strokeWidth="3.5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M 78,70 L 78,78 L 70,78" />
        </group>

    </group>
</vector>