<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限（NanoHTTPd 绑定 127.0.0.1） -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- 前台服务保活 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    
    <!-- 推理时阻止 CPU 休眠 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- 阻止 WiFi 进入低功耗模式（后台保持网络响应） -->
    
    <!-- 前台服务通知权限（Android 13+） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- 引导用户关闭电池优化 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".RainyEmbeddingApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RainyEmbedding"
        tools:targetApi="31">
        
        <!-- GPU 加速依赖 -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        
        <!-- Qualcomm NPU (QNN HTP) 系统库依赖 -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
        <uses-native-library android:name="libadsprpc.so" android:required="false" />
        <uses-native-library android:name="libsdsprpc.so" android:required="false" />
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.RainyEmbedding">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Embedding 推理服务器前台服务 -->
        <service
            android:name=".service.EmbeddingServerService"
            android:foregroundServiceType="specialUse|dataSync"
            android:exported="false" />
    </application>

</manifest>